  "version": "2.1.3",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": "^8.4",
    "contexis/wp-github-updater": "^0.3.0"
  },
  "autoload": {
    "psr-4": {
      "Contexis\\Expose\\": "lib/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
